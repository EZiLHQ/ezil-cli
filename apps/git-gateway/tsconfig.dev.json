{
	/*
	 * The DEVELOPMENT configuration: everything, including the tests, with Bun's
	 * types. See `tsconfig.json` for why the two are separate; `bun run
	 * typecheck` runs both, so neither half rots.
	 */
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ESNext", "DOM"]
	},
	"include": ["src/**/*.ts"]
}
